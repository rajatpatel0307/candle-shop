NODE_ENV=development
PORT=3000
FRONTEND_ORIGINS=http://localhost:5173

# SQL auth mode, default driver:
DB_DRIVER=tedious
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=CandleEcommerce
DB_USER=sa
DB_PASSWORD=your_strong_password
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Windows Integrated Security / SSMS trusted connection:
# npm install msnodesqlv8
# DB_DRIVER=msnodesqlv8
# DB_SERVER=RAJAT_PATEL\SQLEXPRESS
# DB_NAME=CandleEcommerce
# DB_ENCRYPT=false
# DB_TRUST_SERVER_CERTIFICATE=true

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=candle-commerce-api
JWT_AUDIENCE=candle-commerce-web
REFRESH_TOKEN_EXPIRES_DAYS=30
EMAIL_VERIFICATION_EXPIRES_MINUTES=60
PASSWORD_RESET_EXPIRES_MINUTES=30
BCRYPT_ROUNDS=12
FRONTEND_URL=http://localhost:5173

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Candle Commerce <no-reply@localhost>

LOG_LEVEL=info

# Razorpay server-side credentials. Leave empty for local non-charging flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
